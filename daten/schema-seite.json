{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Krafft-Kai/Leben-Lernen/daten/schema-seite.json",
  "title": "Schwerpunktseite",
  "description": "Die redaktionellen Bausteine einer Schwerpunktseite (Thema × Altersgruppe). Dateien in daten/seiten/<thema>.json enthalten ein Array solcher Objekte. Fakten stehen nicht hier, sondern als Aussagen in daten/themen/; diese Datei verweist nur auf ihre IDs. Nur Aussagen mit status geprueft oder korrigiert dürfen verwendet werden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["thema", "altersgruppe", "stand", "status", "zielgruppen"],
  "properties": {
    "thema": { "type": "string" },
    "altersgruppe": { "type": "string", "enum": ["0-3", "3-6", "6-10", "10-13", "13-16", "16-19", "19-27", "27-65", "65-plus"] },
    "titel": { "type": "string", "description": "Optionaler eigener Seitentitel, sonst „<Thema> · <Altersgruppe>“." },
    "stand": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["entwurf", "veroeffentlicht"] },
    "zielgruppen": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "eltern": { "$ref": "#/$defs/zielgruppe" },
        "lehrkraefte": { "$ref": "#/$defs/zielgruppe" },
        "jugendliche": { "$ref": "#/$defs/zielgruppe" },
        "erwachsene": { "$ref": "#/$defs/zielgruppe" }
      }
    },
    "hilft": { "type": "array", "items": { "type": "string" }, "description": "IDs von Aussagen mit wirkung hilft, in der Reihenfolge der Anzeige." },
    "schadet": { "type": "array", "items": { "type": "string" }, "description": "IDs von Aussagen mit wirkung schadet." },
    "einordnung": { "type": "array", "items": { "type": "string" }, "description": "IDs weiterer Aussagen (neutral, einordnung)." },
    "gehirn": { "type": "string", "maxLength": 900, "description": "Kasten „Was passiert im Gehirn?“, 2 bis 4 Sätze, nur Belegtes." },
    "weltweit": {
      "type": "array",
      "description": "Kasten „Weltweit bewährt“: Praxis aus anderen Ländern mit Beleg und Ampel. Nur, was evaluiert wurde.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["land", "praxis", "beleg", "ampel", "quelle"],
        "properties": {
          "land": { "type": "string" },
          "praxis": { "type": "string", "description": "Was dort gemacht wird, in ein bis zwei Sätzen." },
          "beleg": { "type": "string", "description": "Was die Evaluation zeigt, mit Effektgröße, wenn vorhanden." },
          "uebertragbarkeit": { "type": "string", "description": "Was für Deutschland oder Niedersachsen daraus folgt, und was nicht." },
          "ampel": { "type": "string", "enum": ["stark", "mittel", "schwach", "umstritten", "mythos"] },
          "quelle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["titel", "jahr", "doi_oder_url"],
            "properties": {
              "titel": { "type": "string" },
              "autoren": { "type": "string" },
              "jahr": { "type": "integer" },
              "doi_oder_url": { "type": "string", "pattern": "^(https?://|10\\.\\d{4,9}/)" }
            }
          }
        }
      }
    },
    "mythen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behauptung", "befund", "aussage_id"],
        "properties": {
          "behauptung": { "type": "string" },
          "befund": { "type": "string" },
          "aussage_id": { "type": "string", "description": "Die Aussage, die den Befund belegt (Ampel und Quelle stehen dort)." }
        }
      }
    },
    "wann_hilfe": { "type": "string" },
    "hilfsangebote": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "fuer": { "type": "string", "description": "z. B. Eltern, Jugendliche, bundesweit, Niedersachsen" },
          "telefon": { "type": "string" }
        }
      }
    },
    "aenderungen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datum", "was", "warum"],
        "properties": {
          "datum": { "type": "string", "format": "date" },
          "was": { "type": "string" },
          "warum": { "type": "string" },
          "quelle": { "type": "string" },
          "ausloeser": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "zielgruppe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernaussage", "tipps"],
      "properties": {
        "kernaussage": { "type": "string", "maxLength": 240, "description": "Ein Satz in der Ansprache der Zielgruppe (siehe daten/phasen.json → zielgruppen)." },
        "tipps": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string" }, "description": "3 bis 5 konkrete Schritte." },
        "checkliste": { "type": "array", "maxItems": 12, "items": { "type": "string" }, "description": "Kurze Punkte zum Abhaken; erscheint auf der Druckseite." },
        "gespraech": { "type": "string", "description": "Optional: ein Gesprächseinstieg, z. B. für das Elterngespräch oder das Gespräch mit dem Kind." }
      }
    }
  }
}
