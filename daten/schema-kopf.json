{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Krafft-Kai/Leben-Lernen/daten/schema-kopf.json",
  "title": "Kopf",
  "description": "Eine Forscherin oder ein Forscher mit Kernbefunden, Schlüsselstudien, Kritik und Replikation. Eine Datei je Person in daten/koepfe/<nachname>.json. Bekannte Namen sind nicht automatisch der Forschungsstand; die Gegenposition gehört immer dazu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "fachgebiet", "kurz", "studien", "kritik", "stand", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "fachgebiet": { "type": "string" },
    "institution": { "type": "string" },
    "themen": { "type": "array", "items": { "type": "string" }, "description": "Themen-Slugs, zu denen die Person eingeordnet wird." },
    "kurz": { "type": "string", "maxLength": 600, "description": "Person, Institution, Schwerpunkt in drei Sätzen." },
    "studien": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titel", "jahr", "design", "ergebnis", "doi_oder_url"],
        "properties": {
          "titel": { "type": "string" },
          "jahr": { "type": "integer" },
          "design": { "type": "string", "description": "z. B. RCT mit 1.200 Kindern, Meta-Analyse aus 80 Studien, Buch" },
          "stichprobe": { "type": "string" },
          "ergebnis": { "type": "string" },
          "effektgroesse": { "type": "string", "description": "Wenn vorhanden, z. B. d = 0.4, OR 1.3" },
          "doi_oder_url": { "type": "string", "pattern": "^(https?://|10\\.\\d{4,9}/)" }
        }
      }
    },
    "kritik": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["von", "argument"],
        "properties": {
          "von": { "type": "string" },
          "argument": { "type": "string" },
          "quelle": { "type": "string" },
          "replikation": { "type": "string", "description": "Wurde der Befund wiederholt? Mit welchem Ergebnis?" }
        }
      }
    },
    "praxis": { "type": "string", "description": "Was folgt praktisch für Eltern, Lehrkräfte oder Ältere, und wo ist Vorsicht nötig?" },
    "kernaussagen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["aussage", "ampel"],
        "properties": {
          "aussage": { "type": "string" },
          "ampel": { "type": "string", "enum": ["stark", "mittel", "schwach", "umstritten", "mythos"] },
          "aussage_id": { "type": "string", "description": "Optional: ID einer Aussage in daten/themen/." }
        }
      }
    },
    "stand": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["recherchiert", "geprueft", "korrigiert", "in_diskussion"] },
    "aenderungen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datum", "was", "warum"],
        "properties": {
          "datum": { "type": "string", "format": "date" },
          "was": { "type": "string" },
          "warum": { "type": "string" },
          "quelle": { "type": "string" },
          "ausloeser": { "type": "string" }
        }
      }
    }
  }
}
